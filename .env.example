OPENAI_API_KEY=sk-your-dashscope-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus-latest
MONGO_URI=mongodb://localhost:27017
MONGO_DB=course_gen
REDIS_URL=redis://localhost:6379/0
MAX_REVIEW_RETRIES=2

# ── Concurrency tuning ────────────────────────────────────────────────────────
# How many arq jobs a single worker process handles in parallel.
WORKER_MAX_JOBS=30
# Hard cap on simultaneous LLM API calls per process (guards against 429s).
# Keep this comfortably below your provider's RPM quota / avg_call_seconds.
LLM_MAX_CONCURRENCY=20
# Transient-error retry policy.
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=2.0
LLM_TIMEOUT=180.0
